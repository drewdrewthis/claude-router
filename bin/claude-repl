#!/usr/bin/env bash
# claude-repl — launch Claude Code through the local claude-router proxy with LangWatch
# telemetry wired up. Telemetry is fire-and-forget and NEVER blocks a request; if no
# LangWatch key is found the router still runs, just without traces.
set -euo pipefail

# Repo root = parent of this script's bin/ directory.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${ROUTER_PORT:-3456}"

# --capture-content: opt in to sending prompt text (minus secret-bearing turns) to
# LangWatch. Stripped here so it is never forwarded to `claude` itself.
CAPTURE=0
ARGS=()
for a in "$@"; do
  if [ "$a" = "--capture-content" ]; then
    CAPTURE=1
  else
    ARGS+=("$a")
  fi
done
if [ "${#ARGS[@]}" -gt 0 ]; then set -- "${ARGS[@]}"; else set --; fi

# Resolve the LangWatch key WITHOUT ever echoing it: prefer the explicit env var, else
# pull the Bearer token out of ~/.claude/settings.json's OTEL headers.
if [ -z "${LANGWATCH_API_KEY:-}" ]; then
  LANGWATCH_API_KEY="$(python3 - <<'PY' 2>/dev/null || true
import json, os, re
try:
    with open(os.path.expanduser('~/.claude/settings.json')) as f:
        hdrs = json.load(f).get('env', {}).get('OTEL_EXPORTER_OTLP_HEADERS', '')
    m = re.search(r'Authorization=Bearer\s+([^\s,]+)', hdrs, re.I)
    print(m.group(1) if m else '', end='')
except Exception:
    print('', end='')
PY
)"
fi
# NOT exported: the key is passed inline to the router process only (below), so the `claude`
# subprocess never inherits it.

if [ -z "${LANGWATCH_API_KEY:-}" ]; then
  echo "[claude-repl] WARNING: no LangWatch key found (set LANGWATCH_API_KEY, or add OTEL_EXPORTER_OTLP_HEADERS to ~/.claude/settings.json) — telemetry disabled; routing still works." >&2
fi

if [ "$CAPTURE" = "1" ]; then
  export ROUTER_TELEMETRY_CAPTURE_CONTENT=1
  echo "[claude-repl] WARNING: --capture-content ON — prompt text (minus secret-bearing turns) will be sent to LangWatch." >&2
fi

export ROUTER_PORT="$PORT"

# Start the router in the background; make sure it dies with us. The LangWatch key is passed
# INLINE so only the router sees it — it is never exported into `claude`'s environment.
LANGWATCH_API_KEY="${LANGWATCH_API_KEY:-}" node "$ROOT/router.js" &
PID=$!
trap 'kill "$PID" 2>/dev/null || true' EXIT INT TERM

# Wait (max ~10s) for the port to accept a TCP connection before launching claude.
ready=0
for _ in $(seq 1 100); do
  if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
    exec 3>&- 3<&-
    ready=1
    break
  fi
  sleep 0.1
done
if [ "$ready" != "1" ]; then
  echo "[claude-repl] ERROR: router did not bind 127.0.0.1:$PORT within ~10s." >&2
  exit 1
fi

# Route Claude Code through the local proxy. NOT exec'd — the EXIT trap must fire so the
# background router is always reaped. Capture the exit code so the footer always prints.
rc=0
ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT" claude "$@" || rc=$?

echo "[claude-repl] decision log: $ROOT/decisions.jsonl" >&2
echo "[claude-repl] traces are usually queryable in LangWatch within seconds under service.name=claude-router." >&2
echo "[claude-repl] not showing up? check https://status.langwatch.ai — a degraded Processor delays ingestion by minutes even though the OTLP POST still returns 200." >&2
exit "$rc"
